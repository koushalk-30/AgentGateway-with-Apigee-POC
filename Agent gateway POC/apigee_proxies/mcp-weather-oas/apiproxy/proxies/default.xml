<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <HTTPProxyConnection>
    <BasePath>/mcp</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-Allow</Name>
      </Step>
      <Step>
        <Name>OAuthV2-VerifyAccessToken</Name>
        <Condition>!(proxy.pathsuffix MatchesPath "/token") and !(proxy.pathsuffix MatchesPath "/authorize") and (request.header.x-api-key = null) and (request.header.Authorization != null)</Condition>
      </Step>
      <Step>
        <Name>AM-PropagateOAuthApiKey</Name>
        <Condition>!(proxy.pathsuffix MatchesPath "/token") and !(proxy.pathsuffix MatchesPath "/authorize") and (request.header.x-api-key = null) and (client_id != null)</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
        <!-- Always verify x-api-key on every /mcp request -->
        <Condition>!(proxy.pathsuffix MatchesPath "/token") and !(proxy.pathsuffix MatchesPath "/authorize")</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="Authorize">
      <Description>Generate OAuth Authorization Code</Description>
      <Request>
        <Step>
          <Name>OAuthV2-GenerateAuthorizationCode</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/authorize") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="GenerateToken">
      <Description>Generate OAuth Access Token</Description>
      <Request>
        <Step>
          <Name>OAuthV2-GenerateAccessToken</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/token") and (request.verb = "POST")</Condition>
    </Flow>
  </Flows>
  <RouteRule name="no-target">
    <Condition>(proxy.pathsuffix MatchesPath "/token") or (proxy.pathsuffix MatchesPath "/authorize")</Condition>
  </RouteRule>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
